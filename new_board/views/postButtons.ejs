<button onclick="postUp()">추천</button>
<div id="upCount"><%=upCounts%></div>
<button onclick="postDown()">비추천</button>
<div id="downCount"><%=downCounts%></div>

<script>
    const upCounts = document.getElementById("upCount")
    const downCounts = document.getElementById("downCount")
    const postUp = ()=>{
        fetch('/api/post-up',{
            method:"post",
            headers: {'Content-Type': 'application/json'},
            body:JSON.stringify({postId:'<%=postId%>'})}).then(res=>res.json()).then(result=>{
            upCounts.innerHTML=`추천 : ${result.goods}`
            console.log('seccuss')
            }).catch(err=>{
                console.log(err)
                if(err.Error==='liked'){
                    alert('중복 추천');
                    history(0);
                }
            })
    }
    const postDown = ()=>{
        fetch('/api/post-down',{
            method:"post",
            headers: {'Content-Type': 'application/json'},
            body:JSON.stringify({postId:'<%=postId%>'})}).then(res=>res.json()).then(result=>{
                downCounts.innerHTML=`비추천 : ${result.bads}`
            }).catch(err=>{console.log(err)})
    }
</script>