<button onclick="postUp()">추천</button>
<div id="upCount"><%=upCounts%></div>
<button onclick="postDown()">비추천</button>
<div id="downCount"><%=downCounts%></div>

<script>
    const upCounts = document.getElementById("upCount")
    const downCounts = document.getElementById("downCount")
    const postUp = async()=>{
        try {
            const res = await fetch('/api/post-up',{
                method:'post',
                headers:{'Content-type':'application/json'},
                body:JSON.stringify({postId:'<%=postId%>'})
            })
            if(!res.ok){
                const err = await res.json()
                throw(err)
            }
            const result = await res.json()
            console.log(result)
            upCounts.innerHTML = `추천 : ${result.goods}`;

            
        } catch (error) {
            alert(error.error)
        }
    }   
    const postDown = async ()=>{
        try {
            const res = await fetch('/api/post-down',{
                method:'post',
                headers:{'Content-type':'application/json'},
                body:JSON.stringify({postId:'<%=postId%>'})
            })
            if(!res.ok){
                const err = await res.json()
                throw(err)
            }
            const result = await res.json()
            console.log(result)
            downCounts.innerHTML = `비추천 : ${result.bads}`;

            
        } catch (error) {
            alert(error.error)
        }    
    }
</script>